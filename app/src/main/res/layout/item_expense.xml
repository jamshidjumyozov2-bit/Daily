<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/dark_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/viewExpIconBg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_bg_card">

            <TextView
                android:id="@+id/tvExpIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🍴"
                android:textSize="18sp"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvExpName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oziq-ovqat"
                android:textColor="@color/dark_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvExpDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13:45 | Nonushta"
                android:textColor="@color/dark_text_secondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvExpAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- 25 000 so'm"
            android:textColor="@color/light_green"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/btnEditExpense"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_edit"
            app:tint="@color/graph_blue"
            android:padding="6dp"
            android:contentDescription="Edit"/>

        <ImageButton
            android:id="@+id/btnDeleteExpense"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="@color/light_green"
            android:padding="6dp"
            android:contentDescription="Delete"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>