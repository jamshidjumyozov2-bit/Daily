<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121827">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header with Title and Search -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qarzlar"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="14dp"
                app:strokeWidth="0dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#94A3B8"
                    android:contentDescription="Qidiruv" />
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>

        <!-- Top Summary Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#1E293B"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BERILGAN"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Aktiv"
                            android:textColor="#EF4444"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/status_bg_red"
                            android:paddingLeft="6dp"
                            android:paddingRight="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"/>
                    </RelativeLayout>
                    <TextView
                        android:id="@+id/tvTotalGiven"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 600 000"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"/>
                    <TextView
                        android:id="@+id/tvGivenCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 ta burch"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#1E293B"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OLINGAN"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Majburiyat"
                            android:textColor="#3B82F6"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/status_bg_blue"
                            android:paddingLeft="6dp"
                            android:paddingRight="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"/>
                    </RelativeLayout>
                    <TextView
                        android:id="@+id/tvTotalTaken"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="350 000"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"/>
                    <TextView
                        android:id="@+id/tvTakenCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 ta kutilmoqda"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>


        <!-- New Debt Input Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:padding="4dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yangi qarz yozuvi"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="MODUL 03"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHAXSNING ISMI"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>
            <EditText
                android:id="@+id/etDebtPerson"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Masalan: Jasur"
                android:background="@drawable/bg_input_dark"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textColor="@color/white"
                android:textColorHint="#475569"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TELEFON RAQAMI"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"/>
                    <EditText
                        android:id="@+id/etDebtPhone"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="+998 90 ..."
                        android:inputType="phone"
                        android:background="@drawable/bg_input_dark"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:textColor="@color/white"
                        android:textColorHint="#475569"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUMMA"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"/>
                    <EditText
                        android:id="@+id/etDebtAmount"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:background="@drawable/bg_input_dark"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:textColor="@color/white"
                        android:textColorHint="#475569"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SABAB / IZOH"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>
            <EditText
                android:id="@+id/etDebtReason"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Qarz sababi / izoh"
                android:background="@drawable/bg_input_dark"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textColor="@color/white"
                android:textColorHint="#475569"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OLINGAN SANA"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"/>
                    <RelativeLayout
                        android:id="@+id/btnDebtDateTaken"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_input_dark"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp">
                        <TextView
                            android:id="@+id/tvDateTaken"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="2026-10-26"
                            android:textColor="@color/white"
                            android:textSize="16sp"/>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/black"/>
                    </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QAYTARISH"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"/>
                    <RelativeLayout
                        android:id="@+id/btnDebtDateDue"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_input_dark"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp">
                        <TextView
                            android:id="@+id/tvDateDue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="2026-11-09"
                            android:textColor="@color/white"
                            android:textSize="16sp"/>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/black"/>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>

            <RadioGroup
                android:id="@+id/rgDebtType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">
                <RadioButton
                    android:id="@+id/rbGiven"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Men bergan qarz (Menga berishadi)"
                    android:textColor="@color/white"
                    android:buttonTint="#10B981"
                    android:checked="true"/>
                <RadioButton
                    android:id="@+id/rbTaken"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Men olgan qarz (Men berishim kerak)"
                    android:textColor="@color/white"
                    android:buttonTint="#3B82F6"
                    android:layout_marginTop="8dp"/>
            </RadioGroup>

            <Button
                android:id="@+id/btnSaveDebt"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="QARZNI SAQLASH"
                android:backgroundTint="#3B82F6"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                app:cornerRadius="16dp"
                android:textSize="16sp"/>

        </LinearLayout>

        <!-- List Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Qarzlar ro'yxati"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"/>

            <TextView
                android:id="@+id/tvDebtCountDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 TA TRANZAKSIYA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#3B82F6"
                android:background="@drawable/bg_input_dark"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>
        </LinearLayout>

        <!-- Filters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btnFilterActive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FAOL"
                android:backgroundTint="#3B82F6"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"
                app:cornerRadius="12dp"/>
            <Button
                android:id="@+id/btnFilterClosed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="YOPILGAN"
                android:backgroundTint="#1E293B"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                app:cornerRadius="12dp"/>
        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDebts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>