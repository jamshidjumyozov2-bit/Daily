<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dark_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XARAJAT NOMI"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dark_text_secondary"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etEditExpName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Masalan: Bozorlik"
            android:background="@drawable/bg_input_dark"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/dark_text_primary"
            android:textColorHint="@color/dark_text_secondary"
            android:textSize="16sp"
            android:inputType="text"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUMMA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dark_text_secondary"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etEditExpAmount"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="0 so'm"
            android:inputType="numberDecimal"
            android:background="@drawable/bg_input_dark"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/dark_text_primary"
            android:textColorHint="@color/dark_text_secondary"
            android:textSize="16sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SANA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_text_secondary"
                    android:layout_marginBottom="10dp"/>
                <EditText
                    android:id="@+id/etEditExpDate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_dark"
                    android:paddingHorizontal="16dp"
                    android:focusable="false"
                    android:textColor="@color/dark_text_primary"
                    android:textColorHint="@color/dark_text_secondary"
                    android:textSize="16sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VAQT"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_text_secondary"
                    android:layout_marginBottom="10dp"/>
                <EditText
                    android:id="@+id/etEditExpTime"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_dark"
                    android:paddingHorizontal="16dp"
                    android:focusable="false"
                    android:textColor="@color/dark_text_primary"
                    android:textColorHint="@color/dark_text_secondary"
                    android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KATEGORIYA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dark_text_secondary"
            android:layout_marginBottom="10dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupEditCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"/>
        </HorizontalScrollView>

    </LinearLayout>
</ScrollView>