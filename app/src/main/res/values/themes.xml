<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Haftalikharajat" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="android:statusBarColor">@color/bg_app</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.Haftalikharajat" parent="Base.Theme.Haftalikharajat" />

    <style name="CustomPickerDialogTheme" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <item name="colorSurface">@color/dark_card</item>
        <item name="android:colorBackground">@color/dark_card</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyles</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyles</item>
    </style>

    <style name="DialogButtonStyles" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NumberPickerStyle">
        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:editTextColor">@color/dark_text_primary</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.App.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>
</resources>